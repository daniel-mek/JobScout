# Local API: PostgreSQL from infrastructure/compose.yaml (development credentials only).
DATABASE_URL=postgresql+psycopg://applyos:applyos-local@127.0.0.1:5432/applyos
ENVIRONMENT=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=7
STORAGE_BACKEND=local
STORAGE_PATH=data/private-files
MAX_UPLOAD_BYTES=5242880
# Server-only Next.js proxy target. Copy this key to apps/web/.env.local for npm dev/build.
API_INTERNAL_URL=http://127.0.0.1:8000
# Production API requires HTTPS WEB_ORIGIN, COOKIE_SECURE=true, PostgreSQL, and S3.
# STORAGE_BACKEND=s3
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY must be supplied privately, or use workload identity.
# No AI/provider/OAuth credentials are required in Phase 1.
